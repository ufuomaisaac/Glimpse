<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Glimpse" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/glimpse_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/glimpse_background</item>
        <item name="android:navigationBarColor">@color/glimpse_background</item>
    </style>

    <style name="Theme.Glimpse.Launcher" parent="Theme.Glimpse">
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>
</resources>
